# --- FREE option 1: Browser (no keys needed) ---
# Just run the frontend, choose "Browser" provider – 100% free, runs in your browser

# --- FREE option 2: Hugging Face (server-side) ---
# Get a free token: https://huggingface.co/settings/tokens  (read role is enough)
# Free tier: ~ generous, no credit card
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=facebook/detr-resnet-50
# Alternative fast model: Xenova/detr-resnet-50  (for transformers.js browser mode)

# --- Paid option: Azure (optional, credits finished? just leave blank) ---
# AZURE_ENDPOINT=https://YOUR_REGION.api.cognitive.microsoft.com
# AZURE_KEY=your_azure_key_here

PORT=5000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
